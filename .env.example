# Railway injects DATABASE_URL when a PostgreSQL service is attached.
DATABASE_URL=

# Optional only when Railway owns the model process. The Hermes worker does not use these.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# The Hermes worker needs the same Railway PostgreSQL URL.
# DATABASE_URL=

# Railway injects PORT automatically. HOST is optional locally.
PORT=4775
HOST=127.0.0.1

# Optional X/Twitter posting for completed meetings. Namespacing prevents use of another account's credentials.
FLYCOROBINHOOD_X_POST_MEETINGS=false
# Public profile link shown in the web UI. Example: https://x.com/your_new_account
FLYCOROBINHOOD_PUBLIC_X_PROFILE_URL=
FLYCOROBINHOOD_X_CONSUMER_KEY=
FLYCOROBINHOOD_X_CONSUMER_SECRET=
FLYCOROBINHOOD_X_BEARER_TOKEN=
# Required for publishing: OAuth 1.0a user access credentials.
FLYCOROBINHOOD_X_ACCESS_TOKEN=
FLYCOROBINHOOD_X_ACCESS_TOKEN_SECRET=